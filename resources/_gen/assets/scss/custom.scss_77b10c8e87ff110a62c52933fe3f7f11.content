@charset "UTF-8";@font-face{font-family:mottoFont;src:url(/fonts/SCRIPTIN.ttf)format("TrueType");font-display:swap}@font-face{font-family:angelinaFont;src:url(/fonts/angelina.ttf)format("TrueType");font-display:swap}@font-face{font-family:jinkaiFont;src:url(/fonts/jinkai.ttf)format("TrueType");font-display:swap}:root{--sys-font-family:jinkaiFont, -apple-system, BlinkMacSystemFont, "Segoe UI", "Droid Sans", "Helvetica Neue";--base-font-family:jinkaiFont, var(--sys-font-family), sans-serif}.site-title{font-family:angelinaFont,var(--base-font-family)!important}.container.compact,.container.extended{max-width:95%;width:95%}@media(min-width:768px){.container.extended{--left-sidebar-max-width:10%;--right-sidebar-max-width:25%;gap:10px}}@media(min-width:1280px){.container.extended{--left-sidebar-max-width:10%;--right-sidebar-max-width:25%}}.container.extended{gap:10px}