@charset "UTF-8";@font-face{font-family:mottoFont;src:url(/fonts/SCRIPTIN.ttf)format("TrueType");font-display:swap}@font-face{font-family:angelinaFont;src:url(/fonts/angelina.ttf)format("TrueType");font-display:swap}@font-face{font-family:jinkaiFont;src:url(/fonts/jinkai.ttf)format("TrueType");font-display:swap}:root{--brand-primary:#2A6B5A;--brand-primary-darker:#1F5042;--brand-primary-lighter:#3E8A75;--brand-soft:rgba(42, 107, 90, 0.08);--brand-soft-hover:rgba(42, 107, 90, 0.16);--brand-palette-1:#2A6B5A;--brand-palette-2:#5A4A8B;--brand-palette-3:#B5743A;--brand-palette-4:#4A7B9C;--brand-palette-5:#8B5A6B;--sys-font-family:jinkaiFont, -apple-system, BlinkMacSystemFont, "Segoe UI", "Droid Sans", "Helvetica Neue";--base-font-family:jinkaiFont, var(--sys-font-family), sans-serif;--heading-font-family:jinkaiFont, var(--base-font-family);--accent-color:var(--brand-primary);--accent-color-darker:var(--brand-primary-darker);--accent-color-text:#fff;--link-background-color:42, 107, 90;--link-background-opacity:0.12;--link-background-opacity-hover:0.22;--scrollbar-thumb:hsl(168, 18%, 70%);--card-border-radius:12px;--article-line-height:1.75;--article-font-size:1.65rem;--shadow-l1:0px 4px 8px rgba(0, 0, 0, 0.04), 0px 0px 2px rgba(0, 0, 0, 0.06), 0px 0px 1px rgba(0, 0, 0, 0.04);--shadow-l2:0px 10px 24px rgba(31, 80, 66, 0.08), 0px 4px 10px rgba(0, 0, 0, 0.04), 0px 0px 1px rgba(0, 0, 0, 0.04);--shadow-l3:0px 16px 32px rgba(31, 80, 66, 0.10), 0px 4px 12px rgba(0, 0, 0, 0.05), 0px 0px 1px rgba(0, 0, 0, 0.04);--scheme-transition:background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease}:root[data-scheme=dark]{--body-background:#1e2724;--accent-color:#4FA88E;--accent-color-darker:#3E8A75;--accent-color-text:#0f1815;--body-text-color:rgba(232, 240, 238, 0.78);--link-background-color:79, 168, 142;--link-background-opacity:0.18;--link-background-opacity-hover:0.28;--scrollbar-thumb:hsl(168, 18%, 30%);--card-background:#2a3a35;--card-background-selected:rgba(79, 168, 142, 0.2);--card-text-color-main:rgba(255, 255, 255, 0.92);--card-text-color-secondary:rgba(232, 240, 238, 0.66);--card-text-color-tertiary:rgba(232, 240, 238, 0.42);--card-separator-color:rgba(255, 255, 255, 0.08);--pre-background-color:#0f1815;--code-background-color:rgba(255, 255, 255, 0.08);--shadow-l1:0px 4px 8px rgba(0, 0, 0, 0.4), 0px 0px 2px rgba(0, 0, 0, 0.5);--shadow-l2:0px 10px 24px rgba(0, 0, 0, 0.5), 0px 4px 10px rgba(0, 0, 0, 0.35);--shadow-l3:0px 16px 32px rgba(0, 0, 0, 0.55), 0px 4px 12px rgba(0, 0, 0, 0.4)}html,body{transition:var(--scheme-transition)}body{color:var(--body-text-color)}.site-title{font-family:angelinaFont,var(--base-font-family)!important;letter-spacing:.5px}.article-title,.section-title{font-family:var(--heading-font-family);font-weight:600;letter-spacing:.3px}.article-title a,a.article-title{transition:color .2s ease,background-color .25s ease}a{transition:color .2s ease,background-color .25s ease}a:hover{color:var(--accent-color-darker)}.article-content a,.post-content a{color:var(--accent-color);text-decoration:none;background-image:linear-gradient(transparent calc(100% - 1px),rgba(var(--link-background-color),var(--link-background-opacity)) calc(100% - 1px));transition:background-image .25s ease,color .2s ease}.article-content a:hover,.post-content a:hover{color:var(--accent-color-darker);background-image:linear-gradient(transparent calc(100% - 1px),rgba(var(--link-background-color),var(--link-background-opacity-hover)) calc(100% - 1px))}.article-list--compact article{transition:transform .2s ease,box-shadow .2s ease,background-color .2s ease;border-radius:8px}.article-list--compact article:hover{transform:translateX(2px);box-shadow:var(--shadow-l1);background-color:var(--brand-soft)}.article-list article{transition:transform .25s ease,box-shadow .25s ease}.article-list article:hover{transform:translateY(-2px);box-shadow:var(--shadow-l2)}.highlight,pre,pre code,.code-block{border-radius:8px!important;font-family:Menlo,Monaco,jetbrains mono,Consolas,courier new,monospace}.highlight{position:relative;margin:1.2em 0;box-shadow:var(--shadow-l1);overflow:hidden}.highlight pre{margin:0;padding:1em 1.1em;border-radius:0}.highlight .lntable,.highlight .lntd{border:none!important}.highlight .lnt,.highlight .ln{border-right:1px solid rgba(127,127,127,.2)!important;padding-right:.6em!important;margin-right:.6em;user-select:none;color:rgba(127,127,127,.6)!important}:not(pre)>code{border-radius:4px;padding:1px 6px;font-size:.92em;font-weight:500}.reading-progress{position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,var(--brand-primary),var(--brand-primary-lighter));box-shadow:0 1px 4px rgba(42,107,90,.4);z-index:9999;transition:width .1s ease-out,opacity .3s ease;opacity:0;pointer-events:none}.reading-progress.is-active{opacity:1}.tagCloud-tags{display:flex;flex-wrap:wrap;gap:6px}.tagCloud-tags a{display:inline-block;padding:4px 11px;border-radius:999px;background-color:var(--brand-soft);color:var(--brand-primary-darker);font-size:.85em;font-weight:500;transition:all .2s ease;border:1px solid transparent}[data-scheme=dark] .tagCloud-tags a{color:#b9e4d3}.tagCloud-tags a:nth-child(5n+1){background-color:rgba(42,107,90,.1);color:#2a6b5a}.tagCloud-tags a:nth-child(5n+2){background-color:rgba(90,74,139,.1);color:#5a4a8b}.tagCloud-tags a:nth-child(5n+3){background-color:rgba(181,116,58,.12);color:#b5743a}.tagCloud-tags a:nth-child(5n+4){background-color:rgba(74,123,156,.1);color:#4a7b9c}.tagCloud-tags a:nth-child(5n+5){background-color:rgba(139,90,107,.1);color:#8b5a6b}[data-scheme=dark] .tagCloud-tags a:nth-child(5n+1){color:#6dc4a7}[data-scheme=dark] .tagCloud-tags a:nth-child(5n+2){color:#a896d4}[data-scheme=dark] .tagCloud-tags a:nth-child(5n+3){color:#e0b07e}[data-scheme=dark] .tagCloud-tags a:nth-child(5n+4){color:#93b8d2}[data-scheme=dark] .tagCloud-tags a:nth-child(5n+5){color:#d2a3b0}.tagCloud-tags a:hover{transform:translateY(-1px);box-shadow:var(--shadow-l1);filter:brightness(.96)}.article-tags a{display:inline-block;padding:2px 9px;margin-right:4px;border-radius:4px;background-color:var(--brand-soft);color:var(--brand-primary-darker);font-size:.82em;transition:all .2s ease}.article-tags a:hover{background-color:var(--brand-soft-hover);color:var(--accent-color-darker)}.widget-archive--list{position:relative;padding-left:6px}.archives-year{position:relative;padding:6px 0 6px 18px;border-left:2px solid var(--card-separator-color);margin-left:4px;transition:all .2s ease}.archives-year::before{content:"";position:absolute;left:-6px;top:14px;width:10px;height:10px;border-radius:50%;background:var(--brand-primary);border:2px solid var(--body-background);box-shadow:0 0 0 2px var(--brand-primary);transition:transform .2s ease,box-shadow .2s ease}.archives-year:hover{border-left-color:var(--brand-primary);padding-left:22px}.archives-year:hover::before{transform:scale(1.25);box-shadow:0 0 0 2px var(--brand-primary),0 0 8px rgba(42,107,90,.5)}.archives-year a{display:flex;align-items:baseline;justify-content:space-between;text-decoration:none}.archives-year .year{font-weight:600;color:var(--card-text-color-main)}.archives-year .count{font-size:.85em;color:var(--card-text-color-tertiary);background:var(--brand-soft);padding:1px 8px;border-radius:999px}#dark-mode-toggle{cursor:pointer;transition:color .25s ease}#dark-mode-toggle:hover{color:var(--accent-color)}.not-found-card{text-align:center;padding:3rem 1rem}.terminal-window{max-width:600px;margin:2rem auto;background:#1e1e1e;color:#d4d4d4;border-radius:8px;box-shadow:var(--shadow-l3);overflow:hidden;font-family:Menlo,Monaco,jetbrains mono,Consolas,monospace;font-size:.9rem;text-align:left;direction:ltr}[data-scheme=light] .terminal-window{background:#1e1e1e;color:#d4d4d4}.terminal-header{background:#2d2d2d;padding:8px 14px;display:flex;align-items:center;gap:8px;border-bottom:1px solid #3e3e3e}.terminal-dot{width:11px;height:11px;border-radius:50%;display:inline-block}.terminal-dot.red{background:#ff5f56}.terminal-dot.yellow{background:#ffbd2e}.terminal-dot.green{background:#27c93f}.terminal-title{margin-left:8px;color:#999;font-size:.78rem}.terminal-body{padding:18px 22px;min-height:180px;line-height:1.7}.terminal-prompt{color:#4fa88e;font-weight:600}.terminal-prompt.error{color:#f44747}.terminal-warn{color:#dcdcaa}.terminal-cursor{display:inline-block;width:8px;height:1em;background:#d4d4d4;margin-left:2px;vertical-align:text-bottom;animation:cursor-blink 1s steps(2)infinite}@keyframes cursor-blink{0%,50%{opacity:1}51%,100%{opacity:0}}.terminal-body a.terminal-link{color:#4fa88e;text-decoration:underline;background:0 0}.terminal-body a.terminal-link:hover{color:#6dc4a7}.container.compact,.container.extended{max-width:95%;width:95%}@media(min-width:768px){.container.extended{--left-sidebar-max-width:10%;--right-sidebar-max-width:25%;gap:10px}}@media(min-width:1280px){.container.extended{--left-sidebar-max-width:10%;--right-sidebar-max-width:25%}}.container.extended{gap:10px}.back-to-top{transition:opacity .25s ease,transform .25s ease}@media(max-width:768px){.menu-social a,.menu a{min-height:44px;display:inline-flex;align-items:center}.highlight pre{padding:.8em .7em;font-size:.88em}}::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-thumb{background:var(--scrollbar-thumb);border-radius:999px;border:2px solid var(--body-background)}::-webkit-scrollbar-thumb:hover{background:var(--brand-primary)}::-webkit-scrollbar-track{background:var(--body-background)}.section-card,.not-found-card{border-radius:var(--card-border-radius);box-shadow:var(--shadow-l1);transition:box-shadow .25s ease,transform .25s ease}::selection{background-color:rgba(42,107,90,.25);color:var(--card-text-color-main)}.pagination{background-color:var(--card-background);border-radius:var(--card-border-radius);box-shadow:var(--shadow-l1);padding:6px;gap:4px;display:flex;align-items:center;justify-content:center}.pagination .page-link{flex:none;min-width:40px;height:40px;padding:0 12px;border-radius:8px;color:var(--card-text-color-secondary);font-weight:500;font-size:.95em;transition:background-color .2s ease,color .2s ease,transform .2s ease,box-shadow .2s ease}.pagination .page-link:not(.pagination-link):not(.disabled){cursor:pointer}.pagination .page-link:hover:not(.current):not(.pagination-link):not(.disabled){background-color:var(--brand-soft);color:var(--brand-primary-darker);transform:translateY(-1px)}[data-scheme=dark] .pagination .page-link:hover:not(.current):not(.pagination-link):not(.disabled){color:#b9e4d3}.pagination .page-link.current{background:linear-gradient(135deg,var(--brand-primary),var(--brand-primary-lighter));color:var(--accent-color-text);font-weight:600;box-shadow:0 2px 6px rgba(42,107,90,.3);cursor:default}[data-scheme=dark] .pagination .page-link.current{box-shadow:0 2px 8px rgba(79,168,142,.4)}.pagination .page-link.pagination-link{min-width:28px;padding:0 6px;color:var(--card-text-color-tertiary);cursor:default}.pagination .page-link[aria-label="Previous page"],.pagination .page-link[aria-label="Next page"]{flex:0 0 40px;min-width:40px;padding:0;background-color:transparent}.pagination .page-link[aria-label="Previous page"]:hover:not(.disabled),.pagination .page-link[aria-label="Next page"]:hover:not(.disabled){background-color:var(--brand-soft);color:var(--brand-primary-darker)}[data-scheme=dark] .pagination .page-link[aria-label="Previous page"]:hover:not(.disabled),[data-scheme=dark] .pagination .page-link[aria-label="Next page"]:hover:not(.disabled){color:#b9e4d3}.pagination .page-link.disabled{opacity:.35;cursor:not-allowed}@media(max-width:480px){.pagination{padding:4px;gap:2px}.pagination .page-link{min-width:34px;height:36px;padding:0 8px;font-size:.9em}}